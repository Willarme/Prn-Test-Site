{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/feature/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sample-ac-job-packet.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=PRN-prepared-AC-sample.pdf"
        }
      ]
    }
  ]
}
