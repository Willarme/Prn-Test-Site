{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/visuals.json",
  "title": "Door v44 visuals",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "heading": {
      "$ref": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/richtext.json"
    },
    "plates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "role": {
            "type": "string",
            "enum": [
              "decision_observation",
              "safe_vs_sealed",
              "why_not_diy",
              "extent",
              "elapsed_time"
            ],
            "minLength": 6,
            "maxLength": 20
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])\\S+(?: \\S+){79,99}$"
          },
          "caption": {
            "$ref": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/richtext.json"
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250,
            "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
          },
          "inline_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 1,
            "maxLength": 128
          },
          "raster_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 1,
            "maxLength": 128
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "mime": {
            "type": "string",
            "enum": [
              "image/png",
              "image/webp"
            ],
            "minLength": 9,
            "maxLength": 10
          },
          "authored_status": {
            "type": "string",
            "enum": [
              "fixture",
              "reviewed"
            ],
            "minLength": 7,
            "maxLength": 8
          },
          "review_receipt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "plate_class": {
            "type": "string",
            "enum": [
              "plate-1",
              "plate-2",
              "plate-3",
              "plate-4"
            ],
            "minLength": 7,
            "maxLength": 7
          }
        },
        "required": [
          "id",
          "asset_id",
          "role",
          "claim_ids",
          "title",
          "description",
          "caption",
          "alt",
          "inline_hash",
          "raster_hash",
          "width",
          "height",
          "mime",
          "authored_status",
          "review_receipt",
          "plate_class"
        ]
      },
      "minItems": 2,
      "maxItems": 4
    }
  },
  "required": [
    "heading",
    "plates"
  ]
}
