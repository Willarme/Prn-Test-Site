{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/observations.json",
  "title": "Door v44 observations",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "heading": {
      "$ref": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/richtext.json"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
          },
          "mw_class": {
            "type": "string",
            "enum": [
              "mw125",
              "mw145",
              "mw150",
              "mw165",
              "mw210",
              "mw240",
              "mw250",
              "mw270",
              "mw300",
              "mw310",
              "mw340"
            ],
            "minLength": 5,
            "maxLength": 5
          }
        },
        "required": [
          "label",
          "mw_class"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "look": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
          },
          "rules_out": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
          },
          "protocol_check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "required": [
          "id",
          "look",
          "rules_out",
          "protocol_check_id"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "heading",
    "columns",
    "rows"
  ]
}
