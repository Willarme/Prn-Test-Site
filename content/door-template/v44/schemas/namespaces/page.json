{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/page.json",
  "title": "Door v44 page",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "meta_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "og_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
    }
  },
  "required": [
    "title",
    "meta_description",
    "og_description"
  ]
}
