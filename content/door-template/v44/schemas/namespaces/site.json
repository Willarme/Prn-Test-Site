{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/site.json",
  "title": "Door v44 site",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name_token": {
      "const": "{{site.name}}",
      "type": "string",
      "minLength": 13,
      "maxLength": 13
    },
    "origin": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^https://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[0-9]{1,5})?$",
      "minLength": 1
    }
  },
  "required": [
    "name_token",
    "origin"
  ]
}
