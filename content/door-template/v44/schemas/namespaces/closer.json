{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/closer.json",
  "title": "Door v44 closer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "heading": {
      "$ref": "https://schemas.propertyresponsenetwork.com/doorspec/namespaces/richtext.json"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s{2})(?![\\s\\S]*[<>\\u0000-\\u001f\\u007f])(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "cta_action": {
      "const": "hero_start",
      "type": "string",
      "minLength": 10,
      "maxLength": 10
    }
  },
  "required": [
    "heading",
    "body",
    "cta_action"
  ]
}
