  "rules": [
    "Compiler owns all DOM attributes.",
    "Disclosure toggles are real buttons with accessible names and governed aria-expanded/aria-controls.",
    "Status regions use role=status or aria-live.",
    "This manifest freezes the v43 source form action; actual runtime wiring is separately tested."
  ]
}
