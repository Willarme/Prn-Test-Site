{
  "name": "property-response-network",
  "version": "0.0.1",
  "private": true,
  "description": "Property Response Network — Black Car trial. One repo, one canonical data model, one shared capability layer.",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "policy": "tsx tools/policy.ts",
    "factory": "tsx tools/run-factory.ts",
    "seed:convert": "python tools/convert-seed-xlsx.py",
    "db:migrate": "tsx tools/db-migrate.ts",
    "smoke:seo": "tsx tools/smoke-dataforseo.ts",
    "ai:policy": "tsx tools/ai-policy.ts",
    "ai:models": "tsx tools/ai-models.ts",
    "ai:smoke": "tsx tools/ai-smoke.ts",
    "evals": "tsx evals/run.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/pg": "^8.23.1",
    "next": "^15.5.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@next/eslint-plugin-next": "^15.5.24",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.20.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
