# NAMES ONLY — never put real secret values in this file or anywhere in the repo.
# Real values live in .env.local (gitignored) locally and in the Vercel/Supabase
# dashboards for deployed environments. See docs/canon/AUTHORITY.md secret rules.

# --- Supabase (needed at Wave 1: durable data spine) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- DataForSEO (needed at Door Wave 1: A04 discovery) — server-side only ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Google Search Console (needed once production domain is verified) ---
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=
GSC_PROPERTY_URL=

# --- OpenAI (needed at Door Wave 3/4: A05 generation, A06 critic; Wave 2: A01/A02) ---
OPENAI_API_KEY=

# --- Google Places (needed at provider resolver wave) ---
GOOGLE_PLACES_API_KEY=

# --- Resend (needed at Customer Lite wave: magic links) ---
RESEND_API_KEY=

# --- Telnyx (needed only when SMS is enabled; stays OFF until 10DLC complete) ---
TELNYX_API_KEY=
